{
    "name": "ticketninja/backend-api",
    "description": "TicketNinja - AI-Powered Event Management & Ticketing Platform API",
    "type": "project",
    "require": {
        "php": "^7.4|^8.0",
        "firebase/php-jwt": "^6.8",
        "guzzlehttp/guzzle": "*",
        "phpmailer/phpmailer": "^7.0",
        "ramsey/uuid": "^4.7",
        "robmorgan/phinx": "*",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Controllers\\": "src/Controllers/",
            "App\\Models\\": "src/Models/",
            "App\\Services\\": "src/Services/",
            "App\\Middleware\\": "src/Middleware/",
            "App\\Utils\\": "src/Utils/",
            "App\\Repositories\\": "src/Repositories/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "vendor/bin/phinx migrate"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
